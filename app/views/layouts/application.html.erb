<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sourcedayproject" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body { font-family: sans-serif; line-height: 1.6; margin: 0; color: #333; }
      nav { background: #333; color: white; padding: 1rem; display: flex; gap: 20px; align-items: center; }
      nav a { color: white; text-decoration: none; font-weight: bold; }
      nav a:hover { text-decoration: underline; }
      .container { max-width: 900px; margin: 20px auto; padding: 0 20px; }
      .flash { padding: 15px; border-radius: 4px; margin-bottom: 20px; }
      .notice { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
      .alert { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
  </head>

  <body>
    <nav>
      <%= link_to "Home", root_path %>
      
      <% if current_user %>
        <%= link_to "My Tasks", tasks_path %>
        
        <% if current_user.todoist_access_token.present? %>
          <span style="color: #2ecc71;">✓ Todoist Linked</span>
        <% else %>
          <%= link_to "Connect Todoist", todoist_connect_path, style: "color: #ff4b42;" %>
        <% end %>

        <div style="margin-left: auto; display: flex; gap: 15px; align-items: center;">
          <span><%= current_user.email %></span>
          <%= button_to "Logout", logout_path, method: :delete, style: "background: none; border: 1px solid white; color: white; cursor: pointer;" %>
        </div>
      <% else %>
        <div style="margin-left: auto;">
          <%= button_to "Dev Login", dev_login_path, method: :post, style: "background: #007bff; color: white; border: none; padding: 5px 15px; border-radius: 4px; cursor: pointer;" %>
        </div>
      <% end %>
    </nav>

    <div class="container">
      <% flash.each do |type, msg| %>
        <div class="flash <%= type %>">
          <%= msg %>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
