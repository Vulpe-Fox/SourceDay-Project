<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sourcedayproject" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav>
      <%= link_to "Home", root_path %>
      <% if current_user %>
        <%= link_to "My Tasks", tasks_path %>
        <% if current_user.todoist_access_token.present? %>
          <span class="status-badge status-connected">✓ Todoist Linked</span>
        <% else %>
          <%= link_to "Connect Todoist", todoist_connect_path, style: "color: #ff4b42;" %>
        <% end %>
        <div style="margin-left: auto; display: flex; gap: 15px; align-items: center;">
          <span><%= current_user.email %></span>
          <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-outline" %>
        </div>
      <% else %>
        <div style="margin-left: auto;">
          <%= button_to "Dev Login", dev_login_path, method: :post, class: "btn btn-dev" %>
        </div>
      <% end %>
    </nav>

    <div class="container">
      <% flash.each do |type, msg| %>
        <div class="flash <%= type %>"><%= msg %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>